# Copy this file to .env for LOCAL use only. Never commit .env.
# On GitHub, store the key under Settings > Secrets and variables > Actions instead (see START-HERE.md).

# Required: your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: use a different Claude model (default: claude-sonnet-5-5; a smaller model costs less)
# ANTHROPIC_MODEL=
